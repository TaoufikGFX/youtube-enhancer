{
  "manifest_version": 3,
  "name": "Enhancer+ for YouTube",
  "short_name": "Enhancer+",
  "description": "Repeat videos, open HD thumbnails, speed & volume boost, screenshots, cinema mode, filters and a cleaner YouTube.",
  "version": "1.0.1",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Enhancer+ for YouTube",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://i.ytimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "exclude_matches": ["*://www.youtube.com/embed/*", "*://www.youtube.com/live_chat*"],
      "js": ["src/content/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "exclude_matches": ["*://www.youtube.com/embed/*", "*://www.youtube.com/live_chat*"],
      "css": ["src/content/youtube.css"],
      "js": [
        "src/shared/defaults.js",
        "src/content/core.js",
        "src/content/features/controls.js",
        "src/content/features/repeat.js",
        "src/content/features/speed.js",
        "src/content/features/audio.js",
        "src/content/features/screenshot.js",
        "src/content/features/cinema.js",
        "src/content/features/pip.js",
        "src/content/features/thumbnail.js",
        "src/content/features/layout.js",
        "src/content/features/miniplayer.js",
        "src/content/features/quality.js",
        "src/content/main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*.woff2"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "description": "Open the popup"
    },
    "toggle-repeat": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle repeat (off / unlimited)"
    },
    "screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Take a screenshot"
    },
    "toggle-cinema": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle cinema mode"
    },
    "open-thumbnail": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open the video thumbnail in best quality"
    },
    "speed-up": { "description": "Increase playback speed" },
    "speed-down": { "description": "Decrease playback speed" },
    "speed-reset": { "description": "Reset playback speed to normal" },
    "toggle-boost": { "description": "Toggle volume boost" },
    "toggle-pip": { "description": "Toggle Picture-in-Picture" },
    "toggle-expand": { "description": "Expand the video player / normal size" },
    "open-options": { "description": "Open settings" }
  }
}
